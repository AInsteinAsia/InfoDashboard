# =============================================================================
# InfoDashboard — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================================================

# --- LLM Provider (at least one required) ------------------------------------
# Supported: claude-sonnet-4-6, claude-opus-4-6, gpt-4o, deepseek-chat, gemini-2.5-flash, etc.
# Note: non-Claude models require OPENAI_API_KEY + OPENAI_BASE_URL (OpenAI-compatible endpoint)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=          # for OpenAI-compatible APIs (DeepSeek, Qwen, Gemini, etc.)
DEFAULT_MODEL=gemini-2.5-flash

# --- Database via SOCKS5 tunnel (frp) ----------------------------------------
# The frp client (frpc) must be running locally before starting this server.
# See tools/frpc-visitor.ini.example for tunnel configuration.
SOCKS5_HOST=127.0.0.1
SOCKS5_PORT=1080
SOCKS5_USER=
SOCKS5_PASS=

DB_HOST=                  # SQL Server host (e.g. 192.168.x.x inside customer network)
DB_PORT=1433
DB_USER=                  # SQL Server login name
DB_PASS=
DB_NAME=

# --- Docker deployment -------------------------------------------------------
DASHBOARD_PORT_START=8501  # first port in the range for generated dashboards
DASHBOARD_PORT_END=8600    # last port in the range
GENERATED_DIR=./generated  # where app.py / Dockerfile files are written
